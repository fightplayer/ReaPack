desc:OTT Multiband Compressor (Upward/Downward Compander)
// Tags: dynamics compressor multiband upward downward ott
// Author: DSP Specialist

slider1:depth=100<0,100,0.1>Depth (%)
slider2:time_scale=100<10,1000,1>Time (%)
slider3:in_gain_db=0<-24,24,0.1>In Gain (dB)
slider4:out_gain_db=0<-24,24,0.1>Out Gain (dB)
slider5:crossover_lm=120<80,300,1>Crossover Low-Mid (Hz)
slider6:crossover_mh=2500<1000,5000,10>Crossover Mid-High (Hz)
slider7:trim_low_db=0<-18,18,0.1>Low Out Trim (dB)
slider8:trim_mid_db=0<-18,18,0.1>Mid Out Trim (dB)
slider9:trim_high_db=0<-18,18,0.1>High Out Trim (dB)
slider10:soft_clip=1<0,1,1{Off,On}>Soft Clip Limiter

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
// -------------------------------------------------------------
// Biquad Filter (Direct Form II Transposed)
// -------------------------------------------------------------
function biquad(x, b0, b1, b2, a1, a2) instance(s1, s2) local(y)
(
  y = b0 * x + s1;
  s1 = b1 * x - a1 * y + s2;
  s2 = b2 * x - a2 * y;
  y;
);

function biquad_reset() instance(s1, s2)
(
  s1 = 0.0;
  s2 = 0.0;
);

function draw_param(px, py, title, val_str)
(
  gfx_setfont(3, "Arial", 11);
  gfx_r = 0.45; gfx_g = 0.50; gfx_b = 0.58;
  gfx_x = px; gfx_y = py;
  gfx_drawstr(title);

  gfx_setfont(1, "Arial", 15, 'b');
  gfx_r = 0.90; gfx_g = 0.92; gfx_b = 0.96;
  gfx_x = px; gfx_y = py + 18;
  gfx_drawstr(val_str);
);

// Denormal & log(0) protection constant (-120 dBFS floor)
DENORM_FLOOR = 0.000000000001;

// -------------------------------------------------------------
// Coefficients Update
// -------------------------------------------------------------
function update_crossover()
local(f1, w1, cos_w1, sin_w1, alpha1, a0_1,
      f2, w2, cos_w2, sin_w2, alpha2, a0_2)
(
  // Low-Mid Crossover (f1)
  f1 = min(max(crossover_lm, 40.0), srate * 0.48);
  w1 = 2.0 * $pi * f1 / srate;
  cos_w1 = cos(w1);
  sin_w1 = sin(w1);
  alpha1 = sin_w1 * 0.7071067811865475; // Q = 1 / sqrt(2)

  // LP1 (Butterworth 2nd-order)
  a0_1 = 1.0 + alpha1;
  lp1_b1 = (1.0 - cos_w1) / a0_1;
  lp1_b0 = lp1_b1 * 0.5;
  lp1_b2 = lp1_b0;
  lp1_a1 = (-2.0 * cos_w1) / a0_1;
  lp1_a2 = (1.0 - alpha1) / a0_1;

  // HP1 (Butterworth 2nd-order)
  hp1_b1 = -(1.0 + cos_w1) / a0_1;
  hp1_b0 = -hp1_b1 * 0.5;
  hp1_b2 = hp1_b0;
  hp1_a1 = lp1_a1;
  hp1_a2 = lp1_a2;

  // Mid-High Crossover (f2)
  f2 = min(max(crossover_mh, f1 + 100.0), srate * 0.48);
  w2 = 2.0 * $pi * f2 / srate;
  cos_w2 = cos(w2);
  sin_w2 = sin(w2);
  alpha2 = sin_w2 * 0.7071067811865475; // Q = 1 / sqrt(2)

  // LP2 (Butterworth 2nd-order)
  a0_2 = 1.0 + alpha2;
  lp2_b1 = (1.0 - cos_w2) / a0_2;
  lp2_b0 = lp2_b1 * 0.5;
  lp2_b2 = lp2_b0;
  lp2_a1 = (-2.0 * cos_w2) / a0_2;
  lp2_a2 = (1.0 - alpha2) / a0_2;

  // HP2 (Butterworth 2nd-order)
  hp2_b1 = -(1.0 + cos_w2) / a0_2;
  hp2_b0 = -hp2_b1 * 0.5;
  hp2_b2 = hp2_b0;
  hp2_a1 = lp2_a1;
  hp2_a2 = lp2_a2;

  // AP2: 2nd-Order Allpass at f2 for Low Band Phase Alignment
  ap2_a1 = lp2_a1;
  ap2_a2 = lp2_a2;
  ap2_b0 = ap2_a2;
  ap2_b1 = ap2_a1;
  ap2_b2 = 1.0;
);

function update_dynamics_timing()
local(scale)
(
  scale = max(time_scale * 0.01, 0.05);

  // OTT Reference Attack / Release times
  // Low: 47.8ms / 282ms, Mid: 22.4ms / 282ms, High: 13.5ms / 132ms
  c_att_low  = exp(-1.0 / (0.0478 * scale * srate));
  c_rel_low  = exp(-1.0 / (0.2820 * scale * srate));

  c_att_mid  = exp(-1.0 / (0.0224 * scale * srate));
  c_rel_mid  = exp(-1.0 / (0.2820 * scale * srate));

  c_att_high = exp(-1.0 / (0.0135 * scale * srate));
  c_rel_high = exp(-1.0 / (0.1320 * scale * srate));

  c_gain_smooth = exp(-1.0 / (0.001 * srate));
  c_meter_decay = exp(-1.0 / (0.080 * srate));
);

// Reset filter memories
lp1_1_L.biquad_reset(); lp1_2_L.biquad_reset();
hp1_1_L.biquad_reset(); hp1_2_L.biquad_reset();
ap2_L.biquad_reset();
lp2_1_L.biquad_reset(); lp2_2_L.biquad_reset();
hp2_1_L.biquad_reset(); hp2_2_L.biquad_reset();

lp1_1_R.biquad_reset(); lp1_2_R.biquad_reset();
hp1_1_R.biquad_reset(); hp1_2_R.biquad_reset();
ap2_R.biquad_reset();
lp2_1_R.biquad_reset(); lp2_2_R.biquad_reset();
hp2_1_R.biquad_reset(); hp2_2_R.biquad_reset();

// Detector state init
env_sq_low  = DENORM_FLOOR;
env_sq_mid  = DENORM_FLOOR;
env_sq_high = DENORM_FLOOR;

g_smooth_low  = 1.0;
g_smooth_mid  = 1.0;
g_smooth_high = 1.0;

// OTT Reference Static Parameters
slope_down_low  = (1.0 / 66.7) - 1.0;
slope_down_mid  = (1.0 / 66.7) - 1.0;
slope_down_high = (1.0 / 1000.0) - 1.0;
slope_up        = 1.0 - (1.0 / 4.17); // ~0.7602

// Thresholds (dB)
T_down_low  = -33.8;
T_up_low    = -40.8;

T_down_mid  = -30.3;
T_up_mid    = -41.8;

T_down_high = -35.5;
T_up_high   = -40.8;

// Fixed Makeups & Pre-gain
makeup_low  = 10.3;
makeup_mid  = 5.7;
makeup_high = 10.3;
pre_gain_db = 5.2;
pre_gain_lin = exp(pre_gain_db * 0.11512925464970228488);

knee_width = 3.0;
half_knee = 1.5;
inv_2knee = 1.0 / (2.0 * knee_width);
max_boost_db = 36.0;

update_crossover();
update_dynamics_timing();

@slider
update_crossover();
update_dynamics_timing();

in_gain_lin   = exp(in_gain_db * 0.11512925464970228488);
out_gain_lin  = exp(out_gain_db * 0.11512925464970228488);
trim_low_lin  = exp(trim_low_db * 0.11512925464970228488);
trim_mid_lin  = exp(trim_mid_db * 0.11512925464970228488);
trim_high_lin = exp(trim_high_db * 0.11512925464970228488);
depth_norm    = depth * 0.01;

@sample
// -------------------------------------------------------------
// 1. Input Gain Stage
// -------------------------------------------------------------
x_in_L = spl0 * in_gain_lin;
x_in_R = spl1 * in_gain_lin;

// -------------------------------------------------------------
// 2. 4th-Order Linkwitz-Riley Crossover with AP2 Compensation
// -------------------------------------------------------------
// Channel Left
low_raw1_L = lp1_1_L.biquad(x_in_L, lp1_b0, lp1_b1, lp1_b2, lp1_a1, lp1_a2);
low_raw2_L = lp1_2_L.biquad(low_raw1_L, lp1_b0, lp1_b1, lp1_b2, lp1_a1, lp1_a2);
band_low_L = ap2_L.biquad(low_raw2_L, ap2_b0, ap2_b1, ap2_b2, ap2_a1, ap2_a2);

hp1_raw1_L = hp1_1_L.biquad(x_in_L, hp1_b0, hp1_b1, hp1_b2, hp1_a1, hp1_a2);
hp1_raw2_L = hp1_2_L.biquad(hp1_raw1_L, hp1_b0, hp1_b1, hp1_b2, hp1_a1, hp1_a2);

mid_raw1_L  = lp2_1_L.biquad(hp1_raw2_L, lp2_b0, lp2_b1, lp2_b2, lp2_a1, lp2_a2);
band_mid_L  = lp2_2_L.biquad(mid_raw1_L, lp2_b0, lp2_b1, lp2_b2, lp2_a1, lp2_a2);

high_raw1_L = hp2_1_L.biquad(hp1_raw2_L, hp2_b0, hp2_b1, hp2_b2, hp2_a1, hp2_a2);
band_high_L = hp2_2_L.biquad(high_raw1_L, hp2_b0, hp2_b1, hp2_b2, hp2_a1, hp2_a2);

// Channel Right
low_raw1_R = lp1_1_R.biquad(x_in_R, lp1_b0, lp1_b1, lp1_b2, lp1_a1, lp1_a2);
low_raw2_R = lp1_2_R.biquad(low_raw1_R, lp1_b0, lp1_b1, lp1_b2, lp1_a1, lp1_a2);
band_low_R = ap2_R.biquad(low_raw2_R, ap2_b0, ap2_b1, ap2_b2, ap2_a1, ap2_a2);

hp1_raw1_R = hp1_1_R.biquad(x_in_R, hp1_b0, hp1_b1, hp1_b2, hp1_a1, hp1_a2);
hp1_raw2_R = hp1_2_R.biquad(hp1_raw1_R, hp1_b0, hp1_b1, hp1_b2, hp1_a1, hp1_a2);

mid_raw1_R  = lp2_1_R.biquad(hp1_raw2_R, lp2_b0, lp2_b1, lp2_b2, lp2_a1, lp2_a2);
band_mid_R  = lp2_2_R.biquad(mid_raw1_R, lp2_b0, lp2_b1, lp2_b2, lp2_a1, lp2_a2);

high_raw1_R = hp2_1_R.biquad(hp1_raw2_R, hp2_b0, hp2_b1, hp2_b2, hp2_a1, hp2_a2);
band_high_R = hp2_2_R.biquad(high_raw1_R, hp2_b0, hp2_b1, hp2_b2, hp2_a1, hp2_a2);

// -------------------------------------------------------------
// 3. Dynamics Processing (Per-Band)
// -------------------------------------------------------------

// --- LOW BAND ---
p_low = 0.5 * (sqr(band_low_L * pre_gain_lin) + sqr(band_low_R * pre_gain_lin)) + DENORM_FLOOR;
p_low > env_sq_low ? (
  env_sq_low = c_att_low * env_sq_low + (1.0 - c_att_low) * p_low;
) : (
  env_sq_low = c_rel_low * env_sq_low + (1.0 - c_rel_low) * p_low;
);
env_db_low = 10.0 * log10(env_sq_low);

// Downward Comp
diff_d_low = env_db_low - T_down_low;
diff_d_low > half_knee ? (
  gd_low = slope_down_low * diff_d_low;
) : diff_d_low > -half_knee ? (
  d = diff_d_low + half_knee;
  gd_low = slope_down_low * (d * d * inv_2knee);
) : (
  gd_low = 0.0;
);

// Upward Comp
diff_u_low = T_up_low - env_db_low;
diff_u_low > half_knee ? (
  gu_low = slope_up * diff_u_low;
) : diff_u_low > -half_knee ? (
  d = diff_u_low + half_knee;
  gu_low = slope_up * (d * d * inv_2knee);
) : (
  gu_low = 0.0;
);
gu_low = min(gu_low, max_boost_db);

// Linear Expansion Gate for Noise Floor (< -70dB to -90dB)
env_db_low < -70.0 ? (
  env_db_low <= -90.0 ? (
    gate_low = 0.0;
  ) : (
    t = (env_db_low - -90.0) * 0.05;
    gate_low = t * t * (3.0 - 2.0 * t);
  );
  gu_low *= gate_low;
);

target_gain_low = exp((gd_low + gu_low + makeup_low) * 0.11512925464970228488);
g_smooth_low = g_smooth_low * c_gain_smooth + target_gain_low * (1.0 - c_gain_smooth);

wet_low_L = band_low_L * (g_smooth_low * pre_gain_lin);
wet_low_R = band_low_R * (g_smooth_low * pre_gain_lin);

proc_low_L = (band_low_L + depth_norm * (wet_low_L - band_low_L)) * trim_low_lin;
proc_low_R = (band_low_R + depth_norm * (wet_low_R - band_low_R)) * trim_low_lin;


// --- MID BAND ---
p_mid = 0.5 * (sqr(band_mid_L * pre_gain_lin) + sqr(band_mid_R * pre_gain_lin)) + DENORM_FLOOR;
p_mid > env_sq_mid ? (
  env_sq_mid = c_att_mid * env_sq_mid + (1.0 - c_att_mid) * p_mid;
) : (
  env_sq_mid = c_rel_mid * env_sq_mid + (1.0 - c_rel_mid) * p_mid;
);
env_db_mid = 10.0 * log10(env_sq_mid);

diff_d_mid = env_db_mid - T_down_mid;
diff_d_mid > half_knee ? (
  gd_mid = slope_down_mid * diff_d_mid;
) : diff_d_mid > -half_knee ? (
  d = diff_d_mid + half_knee;
  gd_mid = slope_down_mid * (d * d * inv_2knee);
) : (
  gd_mid = 0.0;
);

diff_u_mid = T_up_mid - env_db_mid;
diff_u_mid > half_knee ? (
  gu_mid = slope_up * diff_u_mid;
) : diff_u_mid > -half_knee ? (
  d = diff_u_mid + half_knee;
  gu_mid = slope_up * (d * d * inv_2knee);
) : (
  gu_mid = 0.0;
);
gu_mid = min(gu_mid, max_boost_db);

env_db_mid < -70.0 ? (
  env_db_mid <= -90.0 ? (
    gate_mid = 0.0;
  ) : (
    t = (env_db_mid - -90.0) * 0.05;
    gate_mid = t * t * (3.0 - 2.0 * t);
  );
  gu_mid *= gate_mid;
);

target_gain_mid = exp((gd_mid + gu_mid + makeup_mid) * 0.11512925464970228488);
g_smooth_mid = g_smooth_mid * c_gain_smooth + target_gain_mid * (1.0 - c_gain_smooth);

wet_mid_L = band_mid_L * (g_smooth_mid * pre_gain_lin);
wet_mid_R = band_mid_R * (g_smooth_mid * pre_gain_lin);

proc_mid_L = (band_mid_L + depth_norm * (wet_mid_L - band_mid_L)) * trim_mid_lin;
proc_mid_R = (band_mid_R + depth_norm * (wet_mid_R - band_mid_R)) * trim_mid_lin;


// --- HIGH BAND ---
p_high = 0.5 * (sqr(band_high_L * pre_gain_lin) + sqr(band_high_R * pre_gain_lin)) + DENORM_FLOOR;
p_high > env_sq_high ? (
  env_sq_high = c_att_high * env_sq_high + (1.0 - c_att_high) * p_high;
) : (
  env_sq_high = c_rel_high * env_sq_high + (1.0 - c_rel_high) * p_high;
);
env_db_high = 10.0 * log10(env_sq_high);

diff_d_high = env_db_high - T_down_high;
diff_d_high > half_knee ? (
  gd_high = slope_down_high * diff_d_high;
) : diff_d_high > -half_knee ? (
  d = diff_d_high + half_knee;
  gd_high = slope_down_high * (d * d * inv_2knee);
) : (
  gd_high = 0.0;
);

diff_u_high = T_up_high - env_db_high;
diff_u_high > half_knee ? (
  gu_high = slope_up * diff_u_high;
) : diff_u_high > -half_knee ? (
  d = diff_u_high + half_knee;
  gu_high = slope_up * (d * d * inv_2knee);
) : (
  gu_high = 0.0;
);
gu_high = min(gu_high, max_boost_db);

env_db_high < -70.0 ? (
  env_db_high <= -90.0 ? (
    gate_high = 0.0;
  ) : (
    t = (env_db_high - -90.0) * 0.05;
    gate_high = t * t * (3.0 - 2.0 * t);
  );
  gu_high *= gate_high;
);

target_gain_high = exp((gd_high + gu_high + makeup_high) * 0.11512925464970228488);
g_smooth_high = g_smooth_high * c_gain_smooth + target_gain_high * (1.0 - c_gain_smooth);

wet_high_L = band_high_L * (g_smooth_high * pre_gain_lin);
wet_high_R = band_high_R * (g_smooth_high * pre_gain_lin);

proc_high_L = (band_high_L + depth_norm * (wet_high_L - band_high_L)) * trim_high_lin;
proc_high_R = (band_high_R + depth_norm * (wet_high_R - band_high_R)) * trim_high_lin;


// -------------------------------------------------------------
// 4. Output Summing & Limiter
// -------------------------------------------------------------
out_L = (proc_low_L + proc_mid_L + proc_high_L) * out_gain_lin;
out_R = (proc_low_R + proc_mid_R + proc_high_R) * out_gain_lin;

// Soft Clipper (Saturation Limiter above -1.0 dBFS)
soft_clip ? (
  thresh = 0.89125; // -1 dBFS
  margin = 0.10875; // 1.0 - thresh

  abs_L = abs(out_L);
  abs_L > thresh ? (
    delta = (abs_L - thresh) / margin;
    exp_val = exp(min(2.0 * delta, 16.0));
    sat_L = (exp_val - 1.0) / (exp_val + 1.0);
    out_L = (out_L < 0 ? -1.0 : 1.0) * (thresh + margin * sat_L);
  );

  abs_R = abs(out_R);
  abs_R > thresh ? (
    delta = (abs_R - thresh) / margin;
    exp_val = exp(min(2.0 * delta, 16.0));
    sat_R = (exp_val - 1.0) / (exp_val + 1.0);
    out_R = (out_R < 0 ? -1.0 : 1.0) * (thresh + margin * sat_R);
  );
);

spl0 = out_L;
spl1 = out_R;

// -------------------------------------------------------------
// Metering Trackers
// -------------------------------------------------------------
m_in_low  = max(env_db_low, m_in_low * c_meter_decay);
m_in_mid  = max(env_db_mid, m_in_mid * c_meter_decay);
m_in_high = max(env_db_high, m_in_high * c_meter_decay);

m_dn_low  = min(gd_low, m_dn_low + (0.0 - m_dn_low) * (1.0 - c_meter_decay));
m_up_low  = max(gu_low, m_up_low * c_meter_decay);

m_dn_mid  = min(gd_mid, m_dn_mid + (0.0 - m_dn_mid) * (1.0 - c_meter_decay));
m_up_mid  = max(gu_mid, m_up_mid * c_meter_decay);

m_dn_high = min(gd_high, m_dn_high + (0.0 - m_dn_high) * (1.0 - c_meter_decay));
m_up_high = max(gu_high, m_up_high * c_meter_decay);


@gfx 560 380
// -------------------------------------------------------------
// High-Resolution GUI Renderer
// -------------------------------------------------------------
gfx_clear = 0x141619; // Deep Charcoal Background

// --- Header ---
gfx_r = 0.0; gfx_g = 0.82; gfx_b = 1.0; gfx_a = 1.0;
gfx_x = 24; gfx_y = 18;
gfx_setfont(1, "Arial", 20, 'b');
gfx_drawstr("OTT");

gfx_r = 0.85; gfx_g = 0.88; gfx_b = 0.92;
gfx_x = 75; gfx_y = 20;
gfx_setfont(2, "Arial", 14);
gfx_drawstr("MULTIBAND COMPRESSOR");

gfx_r = 0.45; gfx_g = 0.50; gfx_b = 0.58;
gfx_x = 310; gfx_y = 22;
gfx_setfont(3, "Arial", 11);
sprintf(#s_xo, "X-OVER: %d Hz | %.1f kHz", crossover_lm, crossover_mh * 0.001);
gfx_drawstr(#s_xo);

// --- 3 Bands Container ---
card_x = 24;
card_y = 52;
card_w = floor((gfx_w - 72) / 3);
card_h = 210;

band_idx = 0;
loop(3,
  bx = card_x + band_idx * (card_w + 12);
  by = card_y;

  // Background Card
  gfx_r = 0.11; gfx_g = 0.13; gfx_b = 0.16; gfx_a = 1.0;
  gfx_rect(bx, by, card_w, card_h);

  // Border
  gfx_r = 0.18; gfx_g = 0.22; gfx_b = 0.26;
  gfx_line(bx, by, bx + card_w, by);
  gfx_line(bx + card_w, by, bx + card_w, by + card_h);
  gfx_line(bx + card_w, by + card_h, bx, by + card_h);
  gfx_line(bx, by + card_h, bx, by);

  // Band Title & Crossover Range
  gfx_y = by + 12;
  gfx_setfont(1, "Arial", 14, 'b');
  band_idx == 0 ? (
    gfx_r = 0.20; gfx_g = 0.60; gfx_b = 1.0;
    gfx_x = bx + 14; gfx_drawstr("LOW");
    gfx_r = 0.45; gfx_g = 0.50; gfx_b = 0.58;
    gfx_setfont(3, "Arial", 10);
    gfx_x = bx + 55; gfx_drawstr("< ");
    sprintf(#s_f, "%d Hz", crossover_lm); gfx_drawstr(#s_f);

    cur_dn = m_dn_low;
    cur_up = m_up_low;
    cur_in = m_in_low;
    cur_trim = trim_low_db;
  ) : band_idx == 1 ? (
    gfx_r = 0.20; gfx_g = 0.85; gfx_b = 0.45;
    gfx_x = bx + 14; gfx_drawstr("MID");
    gfx_r = 0.45; gfx_g = 0.50; gfx_b = 0.58;
    gfx_setfont(3, "Arial", 10);
    gfx_x = bx + 52;
    sprintf(#s_f, "%d - %.1fk", crossover_lm, crossover_mh * 0.001); gfx_drawstr(#s_f);

    cur_dn = m_dn_mid;
    cur_up = m_up_mid;
    cur_in = m_in_mid;
    cur_trim = trim_mid_db;
  ) : (
    gfx_r = 1.0; gfx_g = 0.75; gfx_b = 0.15;
    gfx_x = bx + 14; gfx_drawstr("HIGH");
    gfx_r = 0.45; gfx_g = 0.50; gfx_b = 0.58;
    gfx_setfont(3, "Arial", 10);
    gfx_x = bx + 60; gfx_drawstr("> ");
    sprintf(#s_f, "%.1fkHz", crossover_mh * 0.001); gfx_drawstr(#s_f);

    cur_dn = m_dn_high;
    cur_up = m_up_high;
    cur_in = m_in_high;
    cur_trim = trim_high_db;
  );

  // Meter Well Background
  meter_x = bx + 14;
  meter_y = by + 40;
  meter_w = card_w - 28;
  meter_h = 125;

  gfx_r = 0.06; gfx_g = 0.07; gfx_b = 0.09;
  gfx_rect(meter_x, meter_y, meter_w, meter_h);

  // Center Zero Reference Line
  center_y = meter_y + (meter_h * 0.5);
  gfx_r = 0.25; gfx_g = 0.28; gfx_b = 0.32;
  gfx_line(meter_x, center_y, meter_x + meter_w, center_y);

  // Upward Comp Bar (Cyan, expanding upwards from center)
  bar_up_h = min(max(cur_up / 36.0, 0.0), 1.0) * (meter_h * 0.48);
  gfx_r = 0.0; gfx_g = 0.80; gfx_b = 1.0; gfx_a = 0.85;
  gfx_rect(meter_x + 8, center_y - bar_up_h, (meter_w - 16) * 0.45, bar_up_h);

  // Downward Comp Bar (Orange/Red, expanding downwards from center)
  bar_dn_h = min(max(-cur_dn / 36.0, 0.0), 1.0) * (meter_h * 0.48);
  gfx_r = 1.0; gfx_g = 0.32; gfx_b = 0.22; gfx_a = 0.85;
  gfx_rect(meter_x + meter_w * 0.52, center_y, (meter_w - 16) * 0.45, bar_dn_h);

  // Input Level Indicator (Vertical stripe)
  norm_in = min(max((cur_in + 60.0) / 60.0, 0.0), 1.0);
  in_h = norm_in * meter_h;
  gfx_r = 0.30; gfx_g = 0.85; gfx_b = 0.45; gfx_a = 0.9;
  gfx_rect(meter_x + meter_w - 4, meter_y + meter_h - in_h, 3, in_h);

  // Numeric Readouts for Up / Down
  gfx_setfont(3, "Arial", 10);
  gfx_r = 0.0; gfx_g = 0.80; gfx_b = 1.0;
  gfx_x = meter_x + 6; gfx_y = center_y - 15;
  sprintf(#s_up, "+%.1f", cur_up);
  gfx_drawstr(#s_up);

  gfx_r = 1.0; gfx_g = 0.35; gfx_b = 0.25;
  gfx_x = meter_x + meter_w * 0.52; gfx_y = center_y + 4;
  sprintf(#s_dn, "%.1f", cur_dn);
  gfx_drawstr(#s_dn);

  // Band Trim Footer
  gfx_x = bx + 14; gfx_y = by + card_h - 28;
  gfx_r = 0.65; gfx_g = 0.70; gfx_b = 0.76;
  cur_trim >= 0.0 ? (
    sprintf(#s_tr, "TRIM: +%.1fdB", cur_trim);
  ) : (
    sprintf(#s_tr, "TRIM: %.1fdB", cur_trim);
  );
  gfx_drawstr(#s_tr);

  band_idx += 1;
);

// --- Bottom Control Bar ---
bot_y = 280;
bot_w = gfx_w - 48;

gfx_r = 0.09; gfx_g = 0.10; gfx_b = 0.13;
gfx_rect(24, bot_y, bot_w, 75);

gfx_r = 0.18; gfx_g = 0.22; gfx_b = 0.26;
gfx_line(24, bot_y, 24 + bot_w, bot_y);
gfx_line(24 + bot_w, bot_y, 24 + bot_w, bot_y + 75);
gfx_line(24 + bot_w, bot_y + 75, 24, bot_y + 75);
gfx_line(24, bot_y + 75, 24, bot_y);

sprintf(#s_dep, "%3.0f%%", depth);
draw_param(44, bot_y + 18, "DEPTH", #s_dep);

sprintf(#s_tim, "%3.0f%%", time_scale);
draw_param(140, bot_y + 18, "TIME", #s_tim);

in_gain_db >= 0.0 ? (
  sprintf(#s_ing, "+%.1f dB", in_gain_db);
) : (
  sprintf(#s_ing, "%.1f dB", in_gain_db);
);
draw_param(235, bot_y + 18, "IN GAIN", #s_ing);

out_gain_db >= 0.0 ? (
  sprintf(#s_oug, "+%.1f dB", out_gain_db);
) : (
  sprintf(#s_oug, "%.1f dB", out_gain_db);
);
draw_param(340, bot_y + 18, "OUT GAIN", #s_oug);

draw_param(445, bot_y + 18, "LIMITER", soft_clip ? "ON" : "OFF");